{
  // Configuration Cloudflare Workers (assets statiques) pour le site Baobab.
  // `npm run deploy` depuis ce dossier : build Vite dans ./dist puis upload.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baobab-site",
  "compatibility_date": "2026-11-15",
  "assets": {
    "directory": "./dist",
    // Site one-page : toute route inconnue renvoie index.html.
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
